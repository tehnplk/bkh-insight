# Copy to .env and fill in real values. Never commit .env.

# HIS = HOSxP on MySQL (hospital production DB, READ-ONLY). Use a DB user that has SELECT grants only.
HIS_HOST=
HIS_PORT=
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# Insight = this app's own PostgreSQL DB (read/write, default port 5432).
INSIGHT_HOST=
INSIGHT_PORT=
INSIGHT_USER=
INSIGHT_PASSWORD=
INSIGHT_DATABASE=

# Auth.js session secret (encrypts the session cookie). Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Production (`next start`) only: set to true behind a reverse proxy, or Auth.js rejects the host (UntrustedHost). Not needed in dev.
AUTH_TRUST_HOST=

# Super user login (Credentials provider). Enabled only while both are set; leave empty to turn it off once SSO is in place.
AUTH_ADMIN_USER=
AUTH_ADMIN_PASSWORD=

# SSO: PLK Health ID (OIDC). Enabled while all four are set.
# REDIRECT_URI must match one registered at the IdP exactly: http://localhost:3000/auth/callback (dev) or https://10.10.10.159/auth/callback (prod)
AUTH_PLKHEALTH_REDIRECT_URI=
AUTH_PLKHEALTH_ISSUER=
AUTH_PLKHEALTH_ID=
AUTH_PLKHEALTH_SECRET=

# Dev only: comma-separated hostnames/patterns allowed to open the dev server by IP from the LAN (no scheme/port), e.g. 192.168.*.*
DEV_ALLOWED_ORIGINS=

# NHSO ENDPOINT (สปสช.) for closing privileges at /fund/close-privilege. The button stays disabled until TOKEN, CLAIM_PATH and SOURCE_ID are set.
# URL defaults to the Test Zone https://test.nhso.go.th/nhsoendpoint/ ; production is https://nhsoapi.nhso.go.th/nhsoendpoint/
NHSO_ENDPOINT_URL=
# Hospital-wide TOKEN KEY of the NHSO ENDPOINT system (never read it from HOSxP nhso_token)
NHSO_ENDPOINT_TOKEN=
# Path of "NHSO Claim Detail" relative to URL, from the Swagger page
NHSO_ENDPOINT_CLAIM_PATH=
# sourceId of this system as registered with NHSO (HOSxP uses BMS01)
NHSO_ENDPOINT_SOURCE_ID=
