# Copy to .env and fill in real values. Never commit .env.

# HIS = HOSxP on MySQL (hospital production DB, READ-ONLY). Use a DB user that has SELECT grants only.
HIS_HOST=
HIS_PORT=
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# Insight = this app's own PostgreSQL DB (read/write, default port 5432).
INSIGHT_HOST=
INSIGHT_PORT=
INSIGHT_USER=
INSIGHT_PASSWORD=
INSIGHT_DATABASE=

# Insight DB backups (scripts/backup-db.sh, /admin/backup, deploy/RESTORE.md). No BACKUP_PASSWORD = no backup (never unencrypted).
# Keep a copy of the password OFF the server: without it the .dump.gpg files cannot be restored.
BACKUP_PASSWORD=
# Defaults to /var/backups/bkh-insight (owned by the app user, mode 700). Files are kept 5 days.
BACKUP_DIR=

# Auth.js session secret (encrypts the session cookie). Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Production (`next start`) only: set to true behind a reverse proxy, or Auth.js rejects the host (UntrustedHost). Not needed in dev.
AUTH_TRUST_HOST=

# Super user login (Credentials provider). Enabled only while both are set; leave empty to turn it off once SSO is in place.
AUTH_ADMIN_USER=
AUTH_ADMIN_PASSWORD=

# SSO: PLK Health ID (OIDC). Enabled while all four are set.
# REDIRECT_URI must match one registered at the IdP exactly: http://localhost:3000/auth/callback (dev) or https://10.10.10.159/auth/callback (prod)
AUTH_PLKHEALTH_REDIRECT_URI=
AUTH_PLKHEALTH_ISSUER=
AUTH_PLKHEALTH_ID=
AUTH_PLKHEALTH_SECRET=

# Dev only: comma-separated hostnames/patterns allowed to open the dev server by IP from the LAN (no scheme/port), e.g. 192.168.*.*
DEV_ALLOWED_ORIGINS=

# NHSO ENDPOINT (สปสช.) for closing privileges at /fund/close-privilege. The button stays disabled until TOKEN, CLAIM_PATH and SOURCE_ID are set.
# URL defaults to the Test Zone https://test.nhso.go.th/nhsoendpoint/ ; production is https://nhsoapi.nhso.go.th/nhsoendpoint/
NHSO_ENDPOINT_URL=
# Hospital-wide TOKEN KEY of the NHSO ENDPOINT system (never read it from HOSxP nhso_token)
NHSO_ENDPOINT_TOKEN=
# Path of "NHSO Claim Detail" relative to URL, from the Swagger page
NHSO_ENDPOINT_CLAIM_PATH=
# sourceId of this system as registered with NHSO (HOSxP uses BMS01)
NHSO_ENDPOINT_SOURCE_ID=

# NHSO SRM right-search for the "ตรวจสอบสิทธิ์" button at /opd/admissions (defaults to production https://srm.nhso.go.th ; Test https://tsrm.nhso.go.th).
# The Bearer token is read server-side from HOSxP nhso_token (latest unexpired), not from .env
SRM_API_URL=

# Licensed beds (เตียงตามกรอบ) used as the bed-occupancy denominator on the home page. Unset = sum of HOSxP ward.bedcount (includes overflow beds)
HOSPITAL_BEDS=90


# npm run eclaim:sync (scripts/eclaim-sync.mjs, runs on a staff PC against their own Chrome). All optional.
# BKH Insight URL open in that Chrome (default http://localhost:3000)
ECLAIM_SYNC_APP_URL=
# 5-digit hospital code on e-Claim (default: taken from REP file names already imported)
ECLAIM_SYNC_HCODE=
# Chrome DevTools browser websocket ws://127.0.0.1:<port>/devtools/browser/<id> (default: read from Chrome's DevToolsActivePort)
ECLAIM_SYNC_CDP=
# zone / province id of the OFC statement page (default: read from that page if it is open in the e-Claim tab)
ECLAIM_SYNC_ZONE=
ECLAIM_SYNC_PROVINCE=
