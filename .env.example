# Copy to .env and fill in real values. Never commit .env.

# HIS = HOSxP on MySQL (hospital production DB, READ-ONLY). Use a DB user that has SELECT grants only.
HIS_HOST=
HIS_PORT=
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# Insight = this app's own PostgreSQL DB (read/write, default port 5432).
INSIGHT_HOST=
INSIGHT_PORT=
INSIGHT_USER=
INSIGHT_PASSWORD=
INSIGHT_DATABASE=
