# Copy to .env and fill in real values. Never commit .env.

# HIS = HOSxP on MySQL (hospital production DB, READ-ONLY). Use a DB user that has SELECT grants only.
HIS_HOST=
HIS_PORT=
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# Insight = this app's own PostgreSQL DB (read/write, default port 5432).
INSIGHT_HOST=
INSIGHT_PORT=
INSIGHT_USER=
INSIGHT_PASSWORD=
INSIGHT_DATABASE=

# Auth.js session secret (encrypts the session cookie). Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Production (`next start`) only: set to true behind a reverse proxy, or Auth.js rejects the host (UntrustedHost). Not needed in dev.
AUTH_TRUST_HOST=

# Super user login (Credentials provider). Enabled only while both are set; leave empty to turn it off once SSO is in place.
AUTH_ADMIN_USER=
AUTH_ADMIN_PASSWORD=

# Dev server only: LAN hostnames/IPs (comma-separated, no http:// or port) allowed to open `npm run dev`, e.g. 192.168.1.10
ALLOWED_DEV_ORIGINS=
