# Nightly encrypted backup of the insight DB (scripts/backup-db.sh nightly), started by bkh-insight-backup.timer.
# Install (on the server, from /var/www/bkh-insight): see deploy/RESTORE.md "ติดตั้ง"
#   sudo cp deploy/bkh-insight-backup*.service deploy/bkh-insight-backup*.timer /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now bkh-insight-backup.timer bkh-insight-backup-verify.timer
# Run now / check: sudo systemctl start bkh-insight-backup.service; journalctl -u bkh-insight-backup.service
# User: same as the app service (bkhadmin) so /admin/backup can read the files and record downloads.
[Unit]
Description=bkh-insight nightly insight DB backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=bkhadmin
Group=bkhadmin
WorkingDirectory=/var/www/bkh-insight
ExecStart=/usr/bin/bash scripts/backup-db.sh nightly
